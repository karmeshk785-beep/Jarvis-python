class JarvisNotifs : NotificationListenerService() {
    override fun onNotificationPosted(sbn: StatusBarNotification?) {
        if (sbn == null || sbn.packageName == packageName) return
        val e = sbn.notification.extras
        val t = e.getCharSequence("android.title")?.toString() ?: ""
        val x = e.getCharSequence("android.text")?.toString() ?: ""
        if (t.isEmpty() && x.isEmpty()) return
        val app = try { packageManager.getApplicationLabel(packageManager.getApplicationInfo(sbn.packageName, 0)).toString() } catch (ex: Exception) { sbn.packageName }
        Skills.notifs.add(0, "$app: $t. $x")
        while (Skills.notifs.size > 10) Skills.notifs.removeAt(Skills.notifs.size - 1)
    }
}

object Skills {
    val notifs = ArrayList<String>()
    private fun go(ctx: Context, i: Intent) { i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK); ctx.startActivity(i) }

    fun handle(ctx: Context, w: String, tts: TextToSpeech?): String? {
        try {
            if (w.contains("yaad rakho") || w.contains("remember")) {
                val note = w.replace("yaad rakho", "").replace("remember", "").trim()
                if (note.isNotEmpty()) {
                    val prefs = ctx.getSharedPreferences("j_memory", 0)
                    prefs.edit().putString("notes", (prefs.getString("notes", "") ?: "") + "\n" + note).apply()
                    return "Theek hai dost, maine yaad rakh liya: $note"
                }
            }
            if (w.contains("kya yaad") || w.contains("what do you remember")) {
                val old = ctx.getSharedPreferences("j_memory", 0).getString("notes", "") ?: ""
                return if (old.isEmpty()) "Abhi tak kuch yaad nahi hai." else "Mujhe yeh yaad hai: $old"
            }
            if (w.contains("photo lagao") || w.contains("background lagao")) {
                val q = w.replace("photo lagao", "").replace("background lagao", "").trim()
                if (q.isNotEmpty()) {
                    Thread {
                        try {
                            val bmp = BitmapFactory.decodeStream(URL("https://source.unsplash.com/1600x900/?${URLEncoder.encode(q, "UTF-8")}").openStream())
                            if (bmp != null) {
                                Hud.updatePhoto(ctx, bmp)
                                tts?.speak("Ji dost, yeh rahi $q ki ekdum HD photo. Sach mein, yeh photo dekh kar dil khush ho gaya!", TextToSpeech.QUEUE_FLUSH, null, "")
                            }
                        } catch (e: Exception) { tts?.speak("Photo nahi mil payi.", TextToSpeech.QUEUE_FLUSH, null, "") }
                    }.start()
                    return "Photo dhoondh raha hoon..."
                }
            }
            if (w.contains("lock karo")) return if (ShizukuUtil.runCmd("input keyevent 26")) "Phone lock kar diya." else "Shizuku chalu nahi hai."
            if (w.contains("unlock karo")) {
                val pin = ctx.getSharedPreferences("j", 0).getString("pin", "") ?: ""
                if (pin.isEmpty()) return "Pehle settings mein PIN save karo."
                Thread {
                    ShizukuUtil.runCmd("input keyevent 224"); Thread.sleep(500)
                    ShizukuUtil.runCmd("input swipe 500 1500 500 500"); Thread.sleep(500)
                    ShizukuUtil.runCmd("input text $pin"); Thread.sleep(200)
                    ShizukuUtil.runCmd("input keyevent 66")
                }.start()
                return "Phone unlock kar raha hoon."
            }
            if (w.contains("phone band") || w.contains("phone off")) return if (ShizukuUtil.runCmd("svc power shutdown")) "Phone band kar raha hoon." else "Shizuku chalu nahi hai."
            if (w.contains("call")) {
                val num = w.filter { it.isDigit() }
                if (num.length >= 7) { go(ctx, Intent(Intent.ACTION_DIAL, Uri.parse("tel:$num"))); return "Call laga raha hoon." }
            }
            if (w.contains("time") || w.contains("samay")) return "Abhi time hai " + java.text.SimpleDateFormat("hh mm a", Locale.getDefault()).format(Date())
            return null
        } catch (e: Exception) { return null }
    }
}

object ShizukuUtil {
    fun runCmd(cmd: String): Boolean {
        return try {
            if (!Shizuku.pingBinder()) return false
            Shizuku.newProcess(arrayOf("sh", "-c", cmd), null, null).waitFor() == 0
        } catch (e: Exception) { false }
    }
}

class JarvisService : Service() {
    private var tts: TextToSpeech? = null
    private var ttsReady = false
    private var busy = false
    private var glow: EdgeGlow? = null
    private var wl: PowerManager.WakeLock? = null
    private var model: Model? = null
    private var recognizer: Recognizer? = null
    private var audioRecord: AudioRecord? = null
    private var isRecording = false
    private val ui = Handler(Looper.getMainLooper())
    private val hist = JSONArray()
    private val SYS = "Tum Jarvis ho. Hamesha Hinglish mein pyaar se baat karo. Jawab chhote rakho."

    override fun onBind(i: Intent?): IBinder? = null

    override fun onStartCommand(i: Intent?, f: Int, id: Int): Int {
        val say = i?.getStringExtra("say")
        if (say != null) { if (Bus.running && ttsReady) speak(say); return START_STICKY }
        if (!Bus.running) {
            try { goForeground() } catch (e: Exception) { stopSelf(); return START_NOT_STICKY }
            Bus.running = true
            initTts(); showGlow(); startWake()
            StorageService.unpack(this, "model", "model",
                { m -> model = m; initVosk(); Bus.log("Vosk 24/7 ON. Mic kabhi band nahi hoga.") },
                { e -> Bus.log("Model fail: ${e.message}") }
            )
        }
        return START_STICKY
    }

    private fun initVosk() {
        try {
            recognizer = Recognizer(model, 16000.0f)
            val bufferSize = AudioRecord.getMinBufferSize(16000, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
            audioRecord = AudioRecord(MediaRecorder.AudioSource.MIC, 16000, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT, bufferSize)
            isRecording = true
            audioRecord?.startRecording()
            Bus.mode = 1
            
            Thread {
                val buffer = ByteArray(bufferSize)
                while (isRecording && Bus.running) {
                    val read = audioRecord?.read(buffer, 0, buffer.size) ?: 0
                    if (read > 0) {
                        // 🔴 MIC HAMESHA ON RAHEGA, PAR JAB JARVIS BOLEGA (busy = true), TOH AUDIO IGNORE HOGA (Echo fix)
                        if (!busy) {
                            if (recognizer?.acceptWaveForm(buffer, read) == true) {
                                val json = JSONObject(recognizer?.result ?: "")
                                if (json.has("text")) {
                                    val text = json.getString("text").trim()
                                    if (text.isNotEmpty()) ui.post { handleVoskText(text.lowercase()) }
                                }
                            }
                        }
                    }
                }
            }.start()
        } catch (e: Exception) { Bus.log("Mic Error: ${e.message}") }
    }

    private fun handleVoskText(q: String) {
        // Sirf tab kaam karega jab "jarvis" bola jaye aur hum busy na hon
        if (q.isEmpty() || busy || (!q.contains("jarvis") && !q.contains("जार्विस"))) return
        
        Bus.log("Aapne kaha: $q")
        var w = q.replace("jarvis", "").replace("जार्विस", "").trim()
        
        busy = true // Isko true karte hi mic background mein chalu rahega par sunna band kar dega
        
        if (w.isEmpty()) { speak("Haan dost, boliye?"); return }
        val sk = Skills.handle(this, w, tts)
        if (sk != null) { speak(sk); return }
        ai(w)
    }

    // Jab Jarvis bolna khatam karega tab ye call hoga
    private fun afterSpeak() {
        busy = false 
        Bus.mode = 1
    }

    private fun startWake() {
        try {
            val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
            wl = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "jarvis:mic")
            wl!!.acquire()
        } catch (e: Exception) {}
    }

    private fun showGlow() {
        try {
            if (glow != null || !Settings.canDrawOverlays(this)) return
            val wm = getSystemService(Context.WINDOW_SERVICE) as WindowManager
            val type = if (Build.VERSION.SDK_INT >= 26) WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY else WindowManager.LayoutParams.TYPE_PHONE
            val flags = WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
            val g = EdgeGlow(this, false)
            wm.addView(g, WindowManager.LayoutParams(-1, -1, type, flags, PixelFormat.TRANSLUCENT))
            glow = g
        } catch (e: Exception) {}
    }

    private fun goForeground() {
        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        val pi = PendingIntent.getActivity(this, 0, Intent(this, JarvisActivity::class.java), PendingIntent.FLAG_IMMUTABLE)
        val nb: Notification.Builder = if (Build.VERSION.SDK_INT >= 26) {
            nm.createNotificationChannel(NotificationChannel("jarvis", "Jarvis", NotificationManager.IMPORTANCE_LOW))
            Notification.Builder(this, "jarvis")
        } else Notification.Builder(this)
        nb.setContentTitle("Jarvis (Vosk 24/7)").setSmallIcon(android.R.drawable.ic_btn_speak_now).setContentIntent(pi)
        if (Build.VERSION.SDK_INT >= 30) startForeground(1, nb.build(), ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE) else startForeground(1, nb.build())
    }

    private fun initTts() {
        tts = TextToSpeech(this) { st ->
            if (st == TextToSpeech.SUCCESS) {
                tts!!.setLanguage(Locale("hi", "IN"))
                tts!!.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
                    override fun onStart(id: String?) {}
                    override fun onError(id: String?) { ui.post { afterSpeak() } }
                    override fun onDone(id: String?) { ui.post { afterSpeak() } }
                })
                ttsReady = true
                speak("Namaste dost, main Jarvis hoon. Mic ab permanent on hai.")
            }
        }
    }

    private fun speak(t: String) {
        var s = t.replace("*", "").take(3500)
        Bus.log("Jarvis: $s")
        Bus.mode = 2; busy = true
        
        // 🔴 Yahan mic stop NAHI kiya gaya hai. Wo background mein on rahega.
        
        if (!ttsReady) { ui.postDelayed({ afterSpeak() }, 1500); return }
        tts!!.speak(s, TextToSpeech.QUEUE_FLUSH, null, "u" + System.currentTimeMillis())
    }

    private fun ai(q: String) {
        val key = getSharedPreferences("j", 0).getString("k", "") ?: ""
        if (key.isEmpty()) { speak("Dost, settings mein Groq key save karo"); return }
        Bus.mode = 3
        hist.put(JSONObject().put("role", "user").put("content", q))
        Thread {
            var ans = ""
            try {
                val msgs = JSONArray().put(JSONObject().put("role", "system").put("content", SYS))
                val mem = getSharedPreferences("j_memory", 0).getString("notes", "") ?: ""
                if (mem.isNotEmpty()) msgs.put(JSONObject().put("role", "system").put("content", "Yaadein: $mem"))
                for (i in Math.max(0, hist.length() - 6) until hist.length()) msgs.put(hist.get(i))
                val body = JSONObject().put("model", "llama3-8b-8192").put("messages", msgs)
                val c = URL("https://api.groq.com/openai/v1/chat/completions").openConnection() as HttpURLConnection
                c.requestMethod = "POST"; c.doOutput = true
                c.setRequestProperty("Content-Type", "application/json")
                c.setRequestProperty("Authorization", "Bearer $key")
                c.outputStream.use { it.write(body.toString().toByteArray()) }
                if (c.responseCode == 200) {
                    ans = JSONObject(c.inputStream.bufferedReader().readText()).getJSONArray("choices").getJSONObject(0).getJSONObject("message").getString("content").trim()
                    hist.put(JSONObject().put("role", "assistant").put("content", ans))
                } else ans = "Groq error de raha hai."
            } catch (e: Exception) { ans = "Internet check karo." }
            ui.post { while (hist.length() > 10) hist.remove(0); speak(ans) }
        }.start()
    }

    override fun onDestroy() {
        super.onDestroy()
        Bus.running = false; Bus.mode = 0; isRecording = false
        try { audioRecord?.stop(); audioRecord?.release() } catch (e: Exception) {}
        try { wl?.release() } catch (e: Exception) {}
        tts?.shutdown()
    }
}

class JarvisActivity : Activity() {
    private lateinit var hud: Hud
    private lateinit var log: TextView
    private lateinit var scroll: ScrollView
    private lateinit var toggle: Button
    private var lastRun = -1
    private lateinit var settings: LinearLayout
    private val ui = Handler(Looper.getMainLooper())
    private var lastVer = -1
    private var polling = false
    
    private val tick = object : Runnable {
        override fun run() {
            hud.mode = Bus.mode
            val rn = if (Bus.running) 1 else 0
            if (rn != lastRun) {
                lastRun = rn
                val bg = GradientDrawable().apply {
                    shape = GradientDrawable.OVAL
                    setColor(if (rn == 1) Color.argb(210, 200, 30, 30) else Color.argb(210, 20, 160, 80))
                }
                toggle.background = bg
                toggle.text = if (rn == 1) "BAND" else "CHALU"
            }
            if (Bus.version != lastVer) {
                lastVer = Bus.version
                log.text = Bus.logs.toString()
                scroll.post { scroll.fullScroll(View.FOCUS_DOWN) }
            }
            if (polling) ui.postDelayed(this, 250)
        }
    }

    override fun onCreate(b: Bundle?) {
        super.onCreate(b)
        val d = resources.displayMetrics.density
        val root = FrameLayout(this)
        hud = Hud(this)
        root.addView(hud, FrameLayout.LayoutParams(-1, -1))
        root.addView(EdgeGlow(this, true), FrameLayout.LayoutParams(-1, -1))
        
        val panel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding((16 * d).toInt(), 0, (16 * d).toInt(), (20 * d).toInt())
        }
        log = TextView(this).apply { setTextColor(Color.WHITE); textSize = 14f }
        scroll = ScrollView(this)
        scroll.addView(log)
        panel.addView(scroll, LinearLayout.LayoutParams(-1, (150 * d).toInt()))
        root.addView(panel, FrameLayout.LayoutParams(-1, -2).apply { gravity = Gravity.BOTTOM })
        
        toggle = Button(this).apply {
            textSize = 13f; setTextColor(Color.WHITE)
            setOnClickListener { if (Bus.running) stopJarvis() else startJarvis() }
        }
        root.addView(toggle, FrameLayout.LayoutParams((88 * d).toInt(), (88 * d).toInt()).apply {
            gravity = Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL; bottomMargin = (210 * d).toInt()
        })
        
        val gear = Button(this).apply { text = "Settings"; setOnClickListener { settings.visibility = View.VISIBLE } }
        root.addView(gear, FrameLayout.LayoutParams(-2, -2).apply {
            gravity = Gravity.TOP or Gravity.END; topMargin = (36 * d).toInt(); rightMargin = (10 * d).toInt()
        })
        
        buildSettingsUI(root, d)
        setContentView(root)
        goFull()
    }

    private fun buildSettingsUI(root: FrameLayout, d: Float) {
        settings = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(Color.argb(240, 20, 20, 20))
            setPadding((20 * d).toInt(), (50 * d).toInt(), (20 * d).toInt(), (20 * d).toInt())
            visibility = View.GONE
        }
        
        settings.addView(Button(this).apply { text = "Close Settings"; setOnClickListener { settings.visibility = View.GONE } })
        
        val keyInput = EditText(this).apply { hint = "Groq API Key"; setText(getSharedPreferences("j", 0).getString("k", "")) }
        settings.addView(keyInput)
        
        val pinInput = EditText(this).apply { hint = "Phone Unlock PIN"; setText(getSharedPreferences("j", 0).getString("pin", "")) }
        settings.addView(pinInput)
        
        settings.addView(Button(this).apply {
            text = "Save Keys"
            setOnClickListener {
                getSharedPreferences("j", 0).edit().putString("k", keyInput.text.toString()).putString("pin", pinInput.text.toString()).apply()
                Toast.makeText(this@JarvisActivity, "Saved!", Toast.LENGTH_SHORT).show()
            }
        })
        
        settings.addView(Button(this).apply {
            text = "Grant Shizuku Permission"
            setOnClickListener {
                try {
                    if (Shizuku.checkSelfPermission() != PackageManager.PERMISSION_GRANTED) Shizuku.requestPermission(0)
                    else Toast.makeText(this@JarvisActivity, "Already Granted!", Toast.LENGTH_SHORT).show()
                } catch (e: Exception) { Toast.makeText(this@JarvisActivity, "Shizuku chalu hai?", Toast.LENGTH_SHORT).show() }
            }
        })
        root.addView(settings, FrameLayout.LayoutParams(-1, -1))
    }

    private fun goFull() {
        window.addFlags(WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS)
        window.statusBarColor = Color.TRANSPARENT
        window.navigationBarColor = Color.TRANSPARENT
        window.decorView.systemUiVisibility = View.SYSTEM_UI_FLAG_LAYOUT_STABLE or View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN or View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION or View.SYSTEM_UI_FLAG_FULLSCREEN or View.SYSTEM_UI_FLAG_HIDE_NAVIGATION or View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
    }

  
